    "steps": [
      { "activeNodeIds": ["prestep", "meter"], "activeEdgeIds": ["prestep->meter"], "title": "Measure pressure", "desc": "After each step, agent/pre-step asks ctx.tokenMeter whether the envelope crossed the threshold." },
      { "activeNodeIds": ["pruner"], "activeEdgeIds": ["meter->pruner"], "title": "Prune tool results", "desc": "ctx.toolResultPruner rewrites oversized tool/result nodes before any summarization call." },
      { "activeNodeIds": ["range"], "activeEdgeIds": ["meter->range", "pruner->range"], "title": "Select range", "desc": "selectCompactableRange() keeps the retained tail and never splits a tool call from its result." },
      { "activeNodeIds": ["lock"], "activeEdgeIds": ["range->lock"], "title": "Acquire lock", "desc": "compaction/start is appended log-only, taking the durable lock before any async work." },
      { "activeNodeIds": ["summarize"], "activeEdgeIds": ["lock->summarize"], "title": "Summarize region", "desc": "summarize() makes one direct ctx.llm.stream() call replaying the shadowed prefix verbatim." },
      { "activeNodeIds": ["checkpoint", "derive"], "activeEdgeIds": ["summarize->checkpoint", "checkpoint->derive"], "title": "Land checkpoint", "desc": "One user/message with surfaceOp=replace shadows the range; deriveMessages() yields checkpoint plus retained tail." }
